# fox.phext.io — Nova Phox, the game. A single self-contained page
# (demo3/index.html) served at the root; the world-state backend is
# phext.tech's /api/v2 (the nova-phox gateway), not this vhost.
# Installed by ~/fox-phext-launch/install.sh.
server {
    listen 80;
    listen [::]:80;
    server_name fox.phext.io;
    server_tokens off;
    return 301 https://fox.phext.io$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name fox.phext.io;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/fox.phext.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fox.phext.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # ACME renewal: the challenge must stay reachable on the final site.
    location /.well-known/acme-challenge/ {
        root /sites/web/fox.phext.io;
    }

    location / {
        root /sites/web/fox.phext.io;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
